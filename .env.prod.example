# Variables de producción para docker-compose.prod.yml (QA-03). Copia este archivo a .env.prod en la VM
# (nunca al repo: .env.prod está en .gitignore) y complétalo. Detalle de cada variable en docs/arquitectura.md.

# URL pública, sin "/" al final. Con https://<dominio> Caddy saca el certificado solo; con http://localhost sirve
# sin HTTPS (para probar en local). Se usa como origen de CORS, URL de la API en el front y regreso de Stripe.
PUBLIC_URL=https://rentsmart-equipo3.brazilsouth.cloudapp.azure.com

# Contraseña del usuario "rentsmart" de PostgreSQL. Solo letras y números (va dentro de la URL de conexión).
POSTGRES_PASSWORD=

# Mínimo 32 caracteres. Genera uno con: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Stripe en modo test: sk_test_ del dashboard y whsec_ del endpoint registrado en Developers > Webhooks
# (URL: <PUBLIC_URL>/api/payments/webhook, eventos checkout.session.completed y checkout.session.expired).
# Sin ellas, la reserva usa el checkout provisorio que no cobra. Déjalas comentadas si no las usas: una variable
# vacía ("STRIPE_SECRET_KEY=") no cuenta como ausente y la API no arranca.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# IA: mock por defecto; para Gemini, AI_PROVIDER=gemini y AI_API_KEY.
AI_PROVIDER=mock
# AI_API_KEY=

# Fotos: local (volumen "uploads" de la VM) por defecto. Para Supabase, STORAGE_DRIVER=supabase y las tres de abajo.
# STORAGE_DRIVER=supabase
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=space-photos
