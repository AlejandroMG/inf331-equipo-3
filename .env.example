# Variables de entorno de RentSmart.
# Copia este archivo como .env dentro de cada app (rentsmart-back/.env, rentsmart-front/.env)
# y completa los valores. Nunca subas un .env con valores reales.

# --- Backend (rentsmart-back) ---
# Puerto HTTP de la API. Si no se define, usa 3000.
PORT=3000
# Conexión a la base de datos de desarrollo (servicio db-dev, host port 5432)
DATABASE_URL=postgresql://devuser:devpassword@localhost:5432/devdb
# Conexión a la base de datos de prueba (servicio db-test, host port 5433)
DATABASE_TEST_URL=postgresql://testuser:testpassword@localhost:5433/testdb

# --- Frontend (rentsmart-front) ---
# Vite solo expone al navegador las variables que empiezan con VITE_.
# URL base de la API que consume el front, sin /api (el cliente HTTP lo agrega).
VITE_API_URL=http://localhost:3000

# Cuando se agreguen la base de datos, la autenticación, Stripe y la IA,
# documenta aquí sus variables (DATABASE_URL, JWT_SECRET, STRIPE_SECRET_KEY, etc.).
